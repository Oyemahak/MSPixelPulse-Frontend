# Optional confirmed public business details. LocalBusiness schema stays disabled
# until a real public street address is supplied.
VITE_BUSINESS_STREET_ADDRESS=
VITE_BUSINESS_CITY=Toronto
VITE_BUSINESS_REGION=Ontario
VITE_BUSINESS_POSTAL_CODE=
VITE_BUSINESS_COUNTRY=CA
VITE_BUSINESS_HOURS=

# Server-side only: used by api/contact.js on Vercel.
RESEND_API_KEY=replace-with-server-side-resend-key
FORMS_TO_EMAIL=info@mspixelpulse.com
FORMS_FROM_EMAIL="MSPixelPulse <info@mspixelpulse.com>"
